# Copy to printer.env and adjust. Not committed -- the address differs per machine.
#
# PRINTER_HOST is the printer's mDNS name, derived from its MAC address, so it
# survives DHCP moving the IP. Prefer it over the raw address.
PRINTER_IP=192.168.1.50
PRINTER_HOST=NPIXXXXXX.local
PRINTER_MODEL=HP_LaserJet_200_colorMFP_M276nw
