#!/usr/bin/env bash
# scanner -- scan from an HP MFP that macOS can no longer talk to.
#
# The printer predates eSCL/AirScan, so macOS dropped its scanning path. HPLIP's
# hpaio backend still speaks the protocol, so it runs in a Debian VM that this
# script treats as a runtime resource: created on demand, started on demand, and
# stopped again once idle.
set -euo pipefail

# Resolve through symlinks: this is normally invoked via ~/.local/bin/scanner, and
# macOS has no `readlink -f`.
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
ROOT="$(cd -P "$(dirname "$_src")/.." && pwd)"
. "$ROOT/lib/common.sh"
. "$ROOT/lib/discover.sh"
. "$ROOT/lib/vm.sh"

# One cleanup path for the whole run: the spinner must never leave the cursor
# hidden or a half-drawn line behind, including on Ctrl-C.
cleanup() { spinner_stop; lock_release; }
# INT/TERM must actually terminate. A handler that only tidies up leaves the
# script running after Ctrl-C, which is not what anyone means by it.
on_signal() { cleanup; exit 130; }
trap cleanup EXIT
trap on_signal INT TERM

OUT_DIR="${SCANBOX_OUT:-$HOME/Pictures/Scans}"
NAME=""; DPI=300; MODE=Color; PAGE=auto; LOSSLESS=0; KEEP_ALIVE=60; PRINTER_OVERRIDE=""
SETUP_OVERWRITE=0; SETUP_HOST=""
SOURCE=auto
CMD=""

usage() {
  cat <<'EOF'
scanbox -- scan from the network MFP

  scanbox scan [SOURCE]   scan, where SOURCE is one of:
                            auto    the feeder if loaded, else the bed (default)
                            feeder  force the document feeder
                            bed     force the flatbed
  scanbox setup           find a scanner and save it as your config
  scanbox status          VM state, config, resolved printer
  scanbox stop            stop the VM now

Options (for setup)
  --host=NAME       skip discovery and use this scanner
  --overwrite       replace an existing config without asking

Options (for scan)
  --out DIR         where PDFs land        (default ~/Pictures/Scans)
  --name NAME       base filename          (default scan-YYYYMMDDHHMMSS)
  --dpi N           resolution             (default 300; 75..1200)
  --mode M          Color|Gray|Lineart     (default Color)
  --page P          auto|letter|legal|a4|max  (default auto)
  --lossless        disable the scanner's in-transit JPEG compression
  --keep-alive MIN  idle minutes before the VM stops (default 60)
  --printer HOST    override the configured scanner for this run
EOF
}

# Scanning moves paper, so it needs an explicit verb rather than being what you
# get for running the command with no arguments.
case "${1:-}" in
  ""|-h|--help)  usage; exit 0 ;;
  scan)
    CMD=scan; shift
    case "${1:-}" in
      auto)        SOURCE=auto;    shift ;;
      feeder)      SOURCE=ADF;     shift ;;
      bed|flatbed) SOURCE=Flatbed; shift ;;
      ""|-*)       SOURCE=auto ;;          # omitted, or options follow directly
      *) die "scan takes auto, feeder or bed (got '$1')" ;;
    esac ;;
  setup)         CMD=setup;      shift ;;
  status)        CMD=status;     shift ;;
  stop)          CMD=stop;       shift ;;
  __idle-timer)  idle_timer_run "${2:-60}"; exit 0 ;;
  -*)            die "no command given -- did you mean 'scanbox scan $1'? (try --help)" ;;
  *)             die "unknown command: $1 (try --help)" ;;
esac

while [ $# -gt 0 ]; do
  case "$1" in
    --out)        OUT_DIR="$2"; shift 2 ;;
    --name)       NAME="$2"; shift 2 ;;
    --dpi)        DPI="$2"; shift 2 ;;
    --mode)       MODE="$2"; shift 2 ;;
    --page)       PAGE="$2"; shift 2 ;;
    --lossless)   LOSSLESS=1; shift ;;
    --keep-alive) KEEP_ALIVE="$2"; shift 2 ;;
    --printer)    PRINTER_OVERRIDE="$2"; shift 2 ;;
    --overwrite)  SETUP_OVERWRITE=1; shift ;;
    --host)       SETUP_HOST="$2"; shift 2 ;;
    --host=*)     SETUP_HOST="${1#--host=}"; shift ;;
    -h|--help)    usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

case "$PAGE" in auto|letter|legal|a4|max) ;; *) die "--page must be auto|letter|legal|a4|max" ;; esac
case "$MODE" in Color|Gray|Lineart) ;; *) die "--mode must be Color, Gray or Lineart" ;; esac

# ---------------------------------------------------------------------------
# find
# ---------------------------------------------------------------------------
# Ask a yes/no question on the terminal. Reads /dev/tty rather than stdin so it
# still works when output is being piped somewhere.
# /dev/tty passes a -r test on permissions even with no controlling terminal, so
# actually opening it is the only reliable check. Done in a subshell to avoid
# leaking a file descriptor.
tty_readable() { ( exec 3</dev/tty ) 2>/dev/null; }

confirm() {
  local prompt="$1" reply
  if ! tty_readable; then
    die "$prompt -- but there is no terminal to ask on. Pass --overwrite."
  fi
  printf '%s [y/N] ' "$prompt" >&2
  read -r reply < /dev/tty || reply=""
  case "$reply" in y|Y|yes|YES|Yes) return 0 ;; *) return 1 ;; esac
}

cmd_setup() {
  local host=""

  # 1. An existing config is confirmed before anything else happens, so a
  #    mistyped `setup` cannot cost you a working configuration. Nothing is
  #    written until the very end regardless.
  if [ -f "$CONFIG_FILE" ] && [ "$SETUP_OVERWRITE" -eq 0 ]; then
    say "This is already configured, at ${CONFIG_FILE/#$HOME/~}:"
    say ""
    sed 's/^/    /' "$CONFIG_FILE" >&2
    say ""
    confirm "Replace it?" || die "setup cancelled -- nothing was changed."
    say ""
  fi

  if [ -n "$SETUP_HOST" ]; then
    host="$SETUP_HOST"
  else
    # 2. Discover, then let the user pick.
    spinner_start "searching for scanners on the network"
    local list; list="$(discover_instances 5)"
    spinner_stop

    local insts=() hosts=() models=() feeders=()
    local inst h m f
    while IFS= read -r inst; do
      [ -n "$inst" ] || continue
      spinner_start "resolving $inst"
      h="$(instance_host "$inst")"
      m="$(instance_txt "$inst" ty)"
      f="$(instance_txt "$inst" feeder)"
      spinner_stop
      insts+=("$inst"); hosts+=("$h"); models+=("$m"); feeders+=("$f")
    done <<EOF
$list
EOF

    local n=${#insts[@]}
    [ "$n" -gt 0 ] || die "no scanners found on this network.
Check the printer is switched on and on the same network as this Mac."

    say "Found $n scanner$([ "$n" -eq 1 ] || echo s):"
    say ""
    local i=0
    while [ "$i" -lt "$n" ]; do
      printf '  %d) %s\n' "$((i + 1))" "${models[$i]:-${insts[$i]}}" >&2
      printf '     %s%s\n' "${hosts[$i]:-<unresolved>}" \
        "$([ "${feeders[$i]}" = "T" ] && echo "  (has a document feeder)")" >&2
      i=$((i + 1))
    done
    say ""

    local choice=""
    if ! tty_readable; then
      die "no terminal to choose on. Re-run with --host=<hostname>."
    fi
    while :; do
      if [ "$n" -eq 1 ]; then
        printf 'Which one? [1] ' >&2
      else
        printf 'Which one? [1-%d] ' "$n" >&2
      fi
      read -r choice < /dev/tty || choice=""
      # A lone Enter takes the only candidate, but never guesses between several.
      [ -z "$choice" ] && [ "$n" -eq 1 ] && choice=1
      case "$choice" in
        ''|*[!0-9]*) ;;
        *) [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ] && break ;;
      esac
      say "  please enter a number between 1 and $n"
    done
    host="${hosts[$((choice - 1))]}"
    [ -n "$host" ] || die "that scanner did not resolve to a hostname; re-run with --host=<hostname>."
    say ""
  fi

  # Confirm it is actually reachable, but do not refuse to save if it is not --
  # setting this up while away from the printer's network is legitimate.
  local ip
  spinner_start "checking $host"
  ip="$(resolve_ipv4 "$host" || true)"
  spinner_stop
  if [ -n "$ip" ]; then
    say "$host resolves to $ip"
  else
    warn "note: $host does not resolve from here. Saving anyway -- it should work
      once you are back on the printer's network."
  fi

  # 3. Only now is anything written, and via a temp file so an interrupted write
  #    cannot leave a half-written config behind.
  local dir tmp
  dir="$(dirname "$CONFIG_FILE")"
  mkdir -p "$dir"
  tmp="$(mktemp -t scanbox-config)"
  cat > "$tmp" <<EOF
# Written by \`scanbox setup\`.
#
# The Bonjour name is derived from the printer's MAC address, so it survives
# DHCP moving the IP. Prefer it over a fixed address.
PRINTER_HOST=$host
EOF
  mv "$tmp" "$CONFIG_FILE"

  say ""
  say "Saved to ${CONFIG_FILE/#$HOME/~}. Scan with:"
  say ""
  say "    scanbox scan"
}

# ---------------------------------------------------------------------------
# Resolve which scanner to talk to.
#
# No guessing: if nothing is configured we stop and explain, even when exactly one
# scanner is present. Silent auto-selection is the kind of magic that becomes
# confusing the day a second device appears.
# ---------------------------------------------------------------------------
resolve_printer() {
  local host="" ip=""

  if [ -n "$PRINTER_OVERRIDE" ]; then
    if is_ipv4 "$PRINTER_OVERRIDE"; then ip="$PRINTER_OVERRIDE"; else host="$PRINTER_OVERRIDE"; fi
  elif [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
    ip="${PRINTER_IP:-}"
    host="${PRINTER_HOST:-}"
  fi

  if [ -z "$ip" ] && [ -z "$host" ]; then
    die "no scanner configured yet. Run:

    scanbox setup"
  fi

  if [ -z "$ip" ]; then
    # The slowest silent step by far when the printer is not on this network.
    spinner_start "looking up $host"
    ip="$(resolve_ipv4 "$host" || true)"
    spinner_stop
    [ -n "$ip" ] || return 1
  fi
  printf '%s\n' "$ip"
}

# HPLIP's own hp-makeuri gives the canonical model string, which beats deriving it
# from the Bonjour name. Cached per address: it costs an SNMP round trip.
device_uri() {
  local ip="$1" cache="$STATE_DIR/uri-$ip" uri
  if [ -f "$cache" ]; then cat "$cache"; return; fi
  # An SNMP round trip; sits for the full timeout if the printer is unreachable.
  spinner_start "identifying the scanner at $ip"
  uri="$(bounded 30 limactl shell "$VM_NAME" hp-makeuri -c "$ip" 2>/dev/null \
         | grep '^hp:/net/' | head -1)"
  spinner_stop
  [ -n "$uri" ] || die "the VM could not identify a scanner at $ip.
Check the printer is on and reachable from this network."
  uri="hpaio:${uri#hp:}"
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$uri" | tee "$cache"
}

cmd_status() {
  require_lima
  printf 'VM          %s\n' "$(vm_exists && vm_status || echo 'not created')"
  printf 'config      %s\n' "$([ -f "$CONFIG_FILE" ] && echo "$CONFIG_FILE" || echo 'none -- run: scanbox setup')"
  if [ -f "$CONFIG_FILE" ]; then
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
    printf 'printer     %s\n' "${PRINTER_HOST:-${PRINTER_IP:-unset}}"
    # Not being able to resolve is a normal thing for status to report, not a
    # reason to abort before printing the rest.
    local ip; ip="$(resolve_printer)" || ip=""
    printf 'address     %s\n' "${ip:-<unresolved> (not on this network?)}"
  fi
  printf 'output      %s\n' "$OUT_DIR"
  if timer_running; then
    printf 'idle timer  running (%ss since last scan)\n' "$(seconds_since_use)"
  else
    printf 'idle timer  not running\n'
  fi
}

cmd_scan() {
  local ip uri out summary
  ip="$(resolve_printer)" || die "could not reach the configured scanner.
Is the printer on, and are you on its network? Run 'scanbox setup' to look again."

  vm_ensure
  lock_acquire

  uri="$(device_uri "$ip")"
  [ -n "$NAME" ] || NAME="scan-$(date +%Y%m%d%H%M%S)"
  mkdir -p "$OUT_DIR"

  spinner_start "scanning"
  # Keep the guest's stderr: it carries the reason a scan failed ("the feeder is
  # empty") and any truncation detail. Swallowing it leaves a bare "scan failed",
  # which tells you nothing about what to do next.
  local errf; errf="$(mktemp -t scanbox)"
  if ! summary="$(limactl shell "$VM_NAME" bash -s -- \
        "$uri" "$SOURCE" "$MODE" "$DPI" "$PAGE" "$LOSSLESS" "$NAME" \
        < "$ROOT/lib/guest-scan.sh" 2>"$errf")"; then
    spinner_stop
    sed 's/^/  /' "$errf" >&2
    rm -f "$errf"
    die "scan failed"
  fi
  spinner_stop
  [ -s "$errf" ] && sed 's/^/  /' "$errf" >&2
  rm -f "$errf"

  printf '%s\n' "$summary" | awk '$1=="PAGE" { printf "  %s: %s (measured %sin)\n", $2, $3, $4 }' >&2

  local guest_pdf used pages
  guest_pdf="$(printf '%s\n' "$summary" | awk '$1=="OUT"    {print $2}')"
  used="$(     printf '%s\n' "$summary" | awk '$1=="SOURCE" {print $2}')"
  pages="$(    printf '%s\n' "$summary" | awk '$1=="PAGES"  {print $2}')"
  [ -n "$guest_pdf" ] || die "the VM produced no output"

  out="$OUT_DIR/$NAME.pdf"
  spinner_start "saving"
  limactl copy "$VM_NAME:$guest_pdf" "$out" >/dev/null 2>&1 \
    || die "could not copy the scan out of the VM"
  spinner_stop

  lock_release
  idle_timer_arm "$KEEP_ALIVE"

  say "$([ "$used" = ADF ] && echo feeder || echo flatbed), $pages page(s)"
  # Never let a short batch look like a clean run.
  if printf '%s\n' "$summary" | grep -q '^TRUNCATED '; then
    say ""
    say "WARNING: the feeder stopped early -- this scan may be missing pages."
    say "         Check the page count above against what you loaded."
  fi
  printf '%s\n' "$out"
}

case "$CMD" in
  setup)  cmd_setup ;;
  status) cmd_status ;;
  stop)   require_lima; vm_stop; say "VM stopped" ;;
  scan)   cmd_scan ;;
esac
