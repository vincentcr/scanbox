#!/bin/sh
# scanbox -- scan from an HP MFP that macOS can no longer talk to.
#
# The host side is Python; only the parts that run inside the Debian VM are
# still shell. This launcher exists to find a usable interpreter and hand off.
#
# Resolve through symlinks first: this is normally invoked via a symlink, from
# ~/.local/bin or from Homebrew's bin, and macOS has no `readlink -f`. The
# package is found relative to the *resolved* path, so it works either way.
src=$0
while [ -L "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd)

# Pick an interpreter by asking it its version rather than by trusting a name.
# `python3` on PATH is preferred so a deliberate choice wins, but a pyenv or
# conda shim pointing at something too old fails the check and we move on
# instead of dying halfway through a scan. scanbox imports only the standard
# library, so any 3.9+ will do -- there is no virtualenv and nothing to install.
py=""
for cand in python3 /usr/bin/python3 python3.14 python3.13 python3.12 python3.11 python3.10; do
  if command -v "$cand" >/dev/null 2>&1 && "$cand" -c \
      'import sys; raise SystemExit(0 if sys.version_info >= (3, 9) else 1)' \
      >/dev/null 2>&1; then
    py=$cand
    break
  fi
done

if [ -z "$py" ]; then
  echo "scanbox: needs python 3.9 or newer, and could not find one." >&2
  echo "         macOS ships one with the Command Line Tools:" >&2
  echo "             xcode-select --install" >&2
  exit 1
fi

PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" export PYTHONPATH
exec "$py" -m scanbox "$@"
