#!/usr/bin/env bash
# Apply (or re-apply) all provisioning to the scanbox VM. Idempotent.
set -euo pipefail
VM="${SCANBOX_VM:-scanbox}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"

for step in "${ROOT}"/provision/*.sh; do
  echo
  echo "################ $(basename "$step")"
  limactl shell "$VM" sudo bash "$step"
done
